{
  "name": "techabanca-catalogue-public",
  "compatibility_date": "2026-09-30",
  "main": "./src/index.ts",
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "techabanca-catalogue-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techabanca-catalogue-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../database/migrations"
    }
  ],
  "vars": {
    "LOCAL_PREVIEW": "false",
    "DEPLOYMENT_ENVIRONMENT": "local"
  },
  "account_id": "00e59d5fe6cfdd53bdc0b8594b5dc8fa",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "techabanca-catalogue-public-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "*.catalogue-preview.techabanca.com/*",
          "zone_name": "techabanca.com"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techabanca-catalogue-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "techabanca-catalogue-staging-assets"
        }
      ],
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "staging",
        "LOCAL_PREVIEW": "false"
      }
    },
    "production": {
      "name": "techabanca-catalogue-public",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techabanca-catalogue-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "techabanca-catalogue-production-assets"
        }
      ],
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production",
        "LOCAL_PREVIEW": "false"
      },
      "triggers": {}
    }
  }
}
