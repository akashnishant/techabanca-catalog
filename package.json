{
  "name": "techabanca-catalogue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:local": "node scripts/dev-local.mjs",
    "dev:app": "npm run dev --workspace @techabanca/catalogue-app",
    "dev:public": "npm run dev --workspace @techabanca/catalogue-public",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run typecheck && npm run test && npm run test:deployment && npm run test:performance && npm run build && npm run performance:verify",
    "cf-typegen": "npm run cf-typegen --workspaces --if-present",
    "db:migrations:list:local": "npx wrangler d1 migrations list techabanca-catalogue-local --local --persist-to .wrangler/state --config apps/catalogue-app/wrangler.jsonc",
    "db:migrate:local": "npx wrangler d1 migrations apply techabanca-catalogue-local --local --persist-to .wrangler/state --config apps/catalogue-app/wrangler.jsonc",
    "test:deployment": "node --test scripts/test-staging.spec.mjs scripts/test-production.spec.mjs",
    "staging:plan": "node scripts/staging.mjs plan",
    "staging:build": "node scripts/staging.mjs build",
    "staging:verify": "node scripts/staging.mjs verify",
    "staging:provision": "node scripts/staging.mjs provision",
    "staging:deploy": "node scripts/staging.mjs deploy",
    "staging:smoke": "node scripts/staging.mjs smoke",
    "test:performance": "node --test scripts/test-performance.spec.mjs",
    "performance:verify": "node scripts/performance.mjs",
    "production:plan": "node scripts/production.mjs plan",
    "production:build": "node scripts/production.mjs build",
    "production:verify": "node scripts/production.mjs verify",
    "production:check": "node scripts/production.mjs check",
    "production:provision": "node scripts/production.mjs provision",
    "production:bootstrap": "node scripts/production.mjs bootstrap",
    "production:deploy": "node scripts/production.mjs deploy",
    "production:smoke": "node scripts/production.mjs smoke"
  }
}
